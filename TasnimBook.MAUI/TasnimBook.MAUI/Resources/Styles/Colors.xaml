<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#1F5A4C</Color>
    <Color x:Key="PrimaryDark">#16483D</Color>
    <Color x:Key="PrimaryDarkText">#183029</Color>
    <Color x:Key="PrimarySoft">#EAF2EF</Color>
    <Color x:Key="Secondary">#F6F4EF</Color>
    <Color x:Key="SecondaryDarkText">#66736E</Color>
    <Color x:Key="Tertiary">#D9A441</Color>
    <Color x:Key="AccentSoft">#F8EED7</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="AppBackground">#F5F4F0</Color>
    <Color x:Key="PageWarmBackground">#F5F4F0</Color>
    <Color x:Key="CardStroke">#E1E5E2</Color>
    <Color x:Key="BodyMuted">#69736F</Color>
    <Color x:Key="BodyText">#3E3A36</Color>
    <Color x:Key="HeaderText">#FFFDF7</Color>
    <Color x:Key="CardShadow">#140E2A22</Color>
    <Color x:Key="InputBackground">#EEF2F0</Color>
    <Color x:Key="InputPlaceholder">#7E8984</Color>
    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ProgressText">#71551E</Color>
    <Color x:Key="ProgressTrack">#DCE8E3</Color>
    <Color x:Key="ReaderBackground">#242424</Color>
    <Color x:Key="ReaderSubtext">#D7E5E0</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <Color x:Key="HomePageBackgroundColor">#F5F4F0</Color>
    <Color x:Key="HomeSurfaceColor">#FFFFFF</Color>
    <Color x:Key="HomePrimaryColor">#1F5A4C</Color>
    <Color x:Key="HomePrimaryDarkColor">#16483D</Color>
    <Color x:Key="HomeTextColor">#183029</Color>
    <Color x:Key="HomeMutedTextColor">#69736F</Color>
    <Color x:Key="HomeBorderColor">#E1E5E2</Color>
    <Color x:Key="HomeImagePlaceholderColor">#EAF2EF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoft}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource Transparent}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
