<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:models="clr-namespace:TasnimBook.Data.Models;assembly=TasnimBook.Data"
                    xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels">

    <Style x:Key="HomeHeaderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource HomePrimaryColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style x:Key="HomeHeaderTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource HeaderText}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeSectionStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HomeSurfaceColor}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HomeBorderColor}, Dark={StaticResource DarkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="16,15,16,13" />
    </Style>

    <Style x:Key="HomeSectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeTextColor}, Dark={StaticResource DarkPrimaryText}}" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeSeeAllButtonStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomePrimaryDarkColor}, Dark=#83C7B7}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style x:Key="HomeBookCardStyle" TargetType="Border">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="WidthRequest" Value="146" />
        <Setter Property="HeightRequest" Value="270" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="HomeBookCoverStyle" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="HeightRequest" Value="205" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <Style x:Key="HomeBookTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeTextColor}, Dark={StaticResource DarkPrimaryText}}" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="HomeBottomBarStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HomeSurfaceColor}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HomeBorderColor}, Dark={StaticResource DarkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="HomeBottomItemStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="HomeBottomIconStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeBottomIconActiveStyle"
           TargetType="Label"
           BasedOn="{StaticResource HomeBottomIconStyle}">
        <Setter Property="TextColor" Value="{StaticResource HomePrimaryDarkColor}" />
    </Style>

    <Style x:Key="HomeBottomTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="HomeBottomImageStyle" TargetType="Image">
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="HomeBottomPathStyle" TargetType="Path">
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="HomeBottomPathActiveStyle"
           TargetType="Path"
           BasedOn="{StaticResource HomeBottomPathStyle}">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource HomePrimaryDarkColor}, Dark=#83C7B7}" />
    </Style>

    <Style x:Key="HomeBottomTextActiveStyle"
           TargetType="Label"
           BasedOn="{StaticResource HomeBottomTextStyle}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomePrimaryDarkColor}, Dark=#83C7B7}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <DataTemplate x:Key="HomeBookCardTemplate" x:DataType="models:BooksDTO">
        <Border Style="{StaticResource HomeBookCardStyle}">
            <Grid RowDefinitions="205,*">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource HomeImagePlaceholderColor}, Dark={StaticResource DarkPrimarySoft}}">
                    <Border.Shadow>
                        <Shadow Brush="#3A0F201B" Offset="0,4" Radius="9" Opacity="0.38" />
                    </Border.Shadow>
                    <Grid>
                        <Image Source="book_cover_placeholder.png"
                               Style="{StaticResource HomeBookCoverStyle}"
                               Margin="32" Opacity="0.4" />
                        <Image Source="{Binding ImageUrl}"
                               Style="{StaticResource HomeBookCoverStyle}" />
                        <Border IsVisible="{Binding IsAudioBook}"
                                Padding="8,4" Margin="8"
                                HorizontalOptions="Start" VerticalOptions="Start"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="#E616483D">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="♪" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                <Label Text="صوتی" TextColor="White" FontSize="10" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Row="1" Padding="3,10,3,0" Spacing="5">
                    <Label Text="{Binding Title}" Style="{StaticResource HomeBookTitleStyle}" />
                    <Label Text="{Binding AuthorName}"
                           FontSize="13"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Start"
                           TextColor="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
