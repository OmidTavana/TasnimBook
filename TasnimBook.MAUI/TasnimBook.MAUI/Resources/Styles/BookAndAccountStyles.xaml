<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="BookDetailHeader" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Padding" Value="18,18,18,16" />
        <Setter Property="HeightRequest" Value="78" />
    </Style>
    <Style x:Key="BookDetailHeaderTitle" TargetType="Label">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="BookDetailCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Shadow">
            <Setter.Value><Shadow Brush="{StaticResource CardShadow}" Offset="0,3" Radius="10" Opacity="0.25" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="SecondaryActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkPrimarySoft}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource DarkPrimaryText}}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="AccountEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource DarkInputBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkPrimaryText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholder}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkPrimaryText}}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="HeaderIconButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style x:Key="AudioSmallIconButton" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style x:Key="AudioPlayIconButton" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="120" />
        <Setter Property="HeightRequest" Value="120" />
        <Setter Property="CornerRadius" Value="60" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Padding" Value="34" />
    </Style>
</ResourceDictionary>
