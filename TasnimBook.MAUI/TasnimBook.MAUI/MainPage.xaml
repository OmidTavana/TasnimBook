<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels"
             x:Class="TasnimBook.MAUI.MainPage"
             x:DataType="viewModels:HomeViewModel"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource HomePageBackgroundColor}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Style="{StaticResource HomeHeaderStyle}">
            <Grid>
                <Label Text="تسنیم‌بوک"
                       Style="{StaticResource HomeHeaderTitleStyle}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="{StaticResource HomePrimaryDarkColor}">
            <ScrollView>
                <VerticalStackLayout Padding="8,12,8,20" Spacing="10">
                    <ActivityIndicator Color="{StaticResource HomePrimaryDarkColor}"
                                       IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       HeightRequest="36" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                           TextColor="{StaticResource HomeMutedTextColor}"
                           HorizontalTextAlignment="Center" />

                    <Border Style="{StaticResource HomeSectionStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های تازه" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه  ‹"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Clicked="NewBooksClicked" />
                            </Grid>
                            <CollectionView x:Name="NewBooksView"
                                            ItemsSource="{Binding NewBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            SelectionMode="Single"
                                            SelectionChanged="BookSelected">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource HomeSectionStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های پیشنهادی" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه  ‹"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Clicked="SuggestedBooksClicked" />
                            </Grid>
                            <CollectionView x:Name="SuggestedBooksView"
                                            ItemsSource="{Binding SuggestedBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            SelectionMode="Single"
                                            SelectionChanged="BookSelected">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource HomeSectionStyle}"
                            IsVisible="{Binding AudioBooks.Count, Converter={StaticResource IntNotZeroConverter}}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های صوتی" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه  ‹"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Clicked="AudioBooksClicked" />
                            </Grid>
                            <CollectionView x:Name="AudioBooksView"
                                            ItemsSource="{Binding AudioBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            SelectionMode="Single"
                                            SelectionChanged="BookSelected">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="2" Style="{StaticResource HomeBottomBarStyle}">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">
                <VerticalStackLayout Grid.Column="0" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⌂" Style="{StaticResource HomeBottomIconActiveStyle}" />
                    <Label Text="خانه" Style="{StaticResource HomeBottomTextActiveStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CatalogTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="☰" Style="{StaticResource HomeBottomIconStyle}" />
                    <Label Text="فهرست" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⌕" Style="{StaticResource HomeBottomIconStyle}" />
                    <Label Text="جست‌وجو" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="LibraryTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="▥" Style="{StaticResource HomeBottomIconStyle}" />
                    <Label Text="کتابخانه" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⚙" Style="{StaticResource HomeBottomIconStyle}" />
                    <Label Text="تنظیمات" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
