<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels"
             x:Class="TasnimBook.MAUI.MainPage"
             x:DataType="viewModels:HomeViewModel"
             FlowDirection="RightToLeft"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light={StaticResource HomePageBackgroundColor}, Dark={StaticResource DarkAppBackground}}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Style="{StaticResource HomeHeaderStyle}">
            <Grid FlowDirection="LeftToRight" ColumnDefinitions="52,*,52">
                <Border Grid.Column="0"
                        WidthRequest="46" HeightRequest="46"
                        BackgroundColor="#20FFFFFF"
                        Stroke="#55FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 23"
                        HorizontalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AccountCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Path Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 0 1 12,3 M4,21 C4.4,15.8 7.2,13 12,13 C16.8,13 19.6,15.8 20,21 Z"
                              Fill="{StaticResource HeaderText}"
                              WidthRequest="25" HeightRequest="25"
                              Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border WidthRequest="10" HeightRequest="10"
                                IsVisible="{Binding IsLoggedOut}"
                                BackgroundColor="#E44B4B"
                                Stroke="{StaticResource HeaderText}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 5"
                                HorizontalOptions="End" VerticalOptions="Start"
                                Margin="0,3,3,0" />
                    </Grid>
                </Border>
                <Label Grid.Column="1" Text="تسنیم‌بوک"
                       Style="{StaticResource HomeHeaderTitleStyle}" />
                <Grid Grid.Column="2" BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="{StaticResource HomePrimaryDarkColor}">
            <ScrollView>
                <VerticalStackLayout Padding="8,12,8,20"
                                     Spacing="10"
                                     MaximumWidthRequest="1100"
                                     HorizontalOptions="Center">
                    <ActivityIndicator Color="{StaticResource HomePrimaryDarkColor}"
                                       IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       HeightRequest="36" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                           TextColor="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}"
                           HorizontalTextAlignment="Center" />

                    <Border Style="{StaticResource HomeSectionStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های تازه" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه"
                                        ImageSource="icon_chevron_left.png"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Command="{Binding NewBooksCommand}" />
                            </Grid>
                            <CollectionView x:Name="NewBooksView"
                                            ItemsSource="{Binding NewBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource HomeSectionStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های پیشنهادی" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه"
                                        ImageSource="icon_chevron_left.png"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Command="{Binding SuggestedBooksCommand}" />
                            </Grid>
                            <CollectionView x:Name="SuggestedBooksView"
                                            ItemsSource="{Binding SuggestedBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource HomeSectionStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="کتاب‌های صوتی" Style="{StaticResource HomeSectionTitleStyle}" />
                                <Button Grid.Column="1"
                                        Text="مشاهده همه"
                                        ImageSource="icon_chevron_left.png"
                                        Style="{StaticResource HomeSeeAllButtonStyle}"
                                        Command="{Binding AudioBooksCommand}" />
                            </Grid>
                            <CollectionView x:Name="AudioBooksView"
                                            ItemsSource="{Binding AudioBooks}"
                                            ItemTemplate="{StaticResource HomeBookCardTemplate}"
                                            HeightRequest="196"
                                            IsVisible="{Binding AudioBooks.Count, Converter={StaticResource IntNotZeroConverter}}"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="14"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Start" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                            <Label Text="هنوز کتاب صوتی ثبت نشده است."
                                   IsVisible="{Binding AudioBooks.Count, Converter={StaticResource IntZeroConverter}}"
                                   TextColor="{AppThemeBinding Light={StaticResource HomeMutedTextColor}, Dark={StaticResource DarkMutedText}}"
                                   HorizontalTextAlignment="Center"
                                   Padding="0,18" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="2" Style="{StaticResource HomeBottomBarStyle}">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">
                <VerticalStackLayout Grid.Column="0" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoadCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M3,11.2 L12,4 L21,11.2 L21,21 L15,21 L15,15 L9,15 L9,21 L3,21 Z"
                          Style="{StaticResource HomeBottomPathActiveStyle}" />
                    <Label Text="خانه" Style="{StaticResource HomeBottomTextActiveStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CatalogCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M4,5 L20,5 L20,7 L4,7 Z M4,11 L20,11 L20,13 L4,13 Z M4,17 L20,17 L20,19 L4,19 Z"
                          Style="{StaticResource HomeBottomPathStyle}" />
                    <Label Text="فهرست" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M10,3 A7,7 0 1 0 14.9,15 L20,20 L21.4,18.6 L16.4,13.5 A7,7 0 0 0 10,3 M10,5 A5,5 0 1 1 10,15 A5,5 0 0 1 10,5 Z"
                          Style="{StaticResource HomeBottomPathStyle}" />
                    <Label Text="جست‌وجو" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LibraryCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M3,4 L8,4 L8,20 L3,20 Z M10,4 L15,4 L15,20 L10,20 Z M17.2,5 L21,4 L24.8,18.8 L20.9,19.8 Z"
                          Style="{StaticResource HomeBottomPathStyle}" />
                    <Label Text="کتابخانه" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" Style="{StaticResource HomeBottomItemStyle}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SettingsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M19.4,13 L19.5,12 L19.4,11 L21.4,9.4 L19.4,6 L17,7 A8,8 0 0 0 15.3,6 L15,3.5 L11,3.5 L10.7,6 A8,8 0 0 0 9,7 L6.6,6 L4.6,9.4 L6.6,11 L6.5,12 L6.6,13 L4.6,14.6 L6.6,18 L9,17 A8,8 0 0 0 10.7,18 L11,20.5 L15,20.5 L15.3,18 A8,8 0 0 0 17,17 L19.4,18 L21.4,14.6 Z M13,16 A4,4 0 1 1 13,8 A4,4 0 0 1 13,16 Z"
                          Style="{StaticResource HomeBottomPathStyle}" />
                    <Label Text="تنظیمات" Style="{StaticResource HomeBottomTextStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
