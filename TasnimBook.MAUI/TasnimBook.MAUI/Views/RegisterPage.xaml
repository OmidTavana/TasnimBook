<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels"
             x:Class="TasnimBook.MAUI.Views.RegisterPage" x:DataType="viewModels:RegisterViewModel" Title="ساخت حساب" FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource PageWarmBackground}">
    <ScrollView><VerticalStackLayout Padding="20,30" Spacing="14">
        <Label Text="ساخت حساب جدید" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <Border Style="{StaticResource BookDetailCard}"><VerticalStackLayout Spacing="12">
            <Entry Text="{Binding DisplayName}" Placeholder="نام نمایشی" Style="{StaticResource AccountEntry}" />
            <Entry Text="{Binding Email}" Placeholder="ایمیل" Keyboard="Email" Style="{StaticResource AccountEntry}" FlowDirection="LeftToRight" />
            <Entry Text="{Binding Password}" Placeholder="رمز عبور" IsPassword="True" Style="{StaticResource AccountEntry}" FlowDirection="LeftToRight" />
            <Entry Text="{Binding ConfirmPassword}" Placeholder="تکرار رمز عبور" IsPassword="True" Style="{StaticResource AccountEntry}" FlowDirection="LeftToRight" />
            <Label Text="حداقل ۱۰ نویسه، شامل حرف و عدد" Style="{StaticResource MutedLabel}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
            <Button Text="{Binding ButtonText}" Style="{StaticResource PrimaryActionButton}" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout></Border>
    </VerticalStackLayout></ScrollView>
</ContentPage>
