<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels"
             xmlns:models="clr-namespace:TasnimBook.Data.Models;assembly=TasnimBook.Data"
             x:Class="TasnimBook.MAUI.Views.BookListPage"
             x:DataType="viewModels:BookListViewModel"
             Title="{Binding Title}"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageWarmBackground}, Dark={StaticResource DarkAppBackground}}">
    <Grid RowDefinitions="Auto,Auto,*" MaximumWidthRequest="1100" HorizontalOptions="Fill">
        <VerticalStackLayout Grid.Row="0" Padding="16,14,16,4" Spacing="3">
            <Label Text="{Binding Title}"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkPrimaryText}}" />
            <Label Text="{Binding Books.Count, StringFormat='{0} کتاب'}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" />
        </VerticalStackLayout>

        <SearchBar Grid.Row="1"
                   Margin="14,6,14,10"
                   Placeholder="{Binding SearchPlaceholder}"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" />

        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView Margin="10,0,10,14"
                            ItemsSource="{Binding Books}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,48" Spacing="10">
                        <Label Text="{Binding EmptyMessage}"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" />
                        <Label Text="{Binding ErrorMessage}"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Error}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BooksDTO">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkBorder}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource CardShadow}" Offset="0,3" Radius="8" Opacity="0.24" />
                            </Border.Shadow>
                            <Grid RowDefinitions="190,Auto">
                                <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,0,0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkPrimarySoft}}">
                                    <Grid>
                                        <Image Source="book_cover_placeholder.png" Aspect="AspectFit" Margin="24" Opacity="0.45" />
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        <Border IsVisible="{Binding IsAudioBook}"
                                                Padding="8,4" Margin="8"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#D916483D">
                                            <Label Text="صوتی" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Row="1" Padding="10,9,10,12" Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="16" FontAttributes="Bold" MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkPrimaryText}}" />
                                    <Label Text="{Binding AuthorName}"
                                           FontSize="12" MaxLines="1" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" />
                                    <Label Text="{Binding CategoryName}"
                                           FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                                           TextColor="{StaticResource Tertiary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           Color="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
