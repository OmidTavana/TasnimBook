<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels" x:Class="TasnimBook.MAUI.Views.BookDetailPage"
             x:DataType="viewModels:BookDetailViewModel" FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageWarmBackground}, Dark={StaticResource DarkAppBackground}}" Title="جزئیات کتاب">
    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource BookDetailHeader}" ColumnDefinitions="52,*,52" FlowDirection="LeftToRight">
            <ImageButton Source="icon_back.png" Style="{StaticResource HeaderIconButton}" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="جزئیات کتاب" Style="{StaticResource BookDetailHeaderTitle}" />
            <ImageButton Grid.Column="2" Source="{Binding HeaderFavoriteIcon}" Style="{StaticResource HeaderIconButton}" Command="{Binding FavoriteCommand}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,34" Spacing="16">
                <Border Style="{StaticResource BookDetailCard}">
                    <Grid ColumnDefinitions="*,142" ColumnSpacing="18" FlowDirection="RightToLeft">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" LineBreakMode="WordWrap" HorizontalTextAlignment="Start" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkPrimaryText}}" />
                            <Label Text="{Binding Author}" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" HorizontalTextAlignment="Start" />
                            <Border BackgroundColor="{StaticResource AccentSoft}" StrokeThickness="0" Padding="10,6" HorizontalOptions="Start" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding ProgressText}" FontSize="13" TextColor="{StaticResource ProgressText}" />
                            </Border>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="142" HeightRequest="205" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Image Source="{Binding CoverImage}" Aspect="AspectFill" />
                        </Border>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsAudioBook}" Style="{StaticResource BookDetailCard}">
                    <VerticalStackLayout BindingContext="{Binding AudioPlayer}" x:DataType="{x:Null}" Spacing="14">
                        <Label Text="پخش کتاب صوتی" Style="{StaticResource SectionHeading}" HorizontalTextAlignment="Center" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
                        <Slider x:Name="AudioProgressSlider"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding IsReady}"
                                DragStarted="OnAudioSeekStarted"
                                DragCompleted="OnAudioSeekCompleted" />
                        <Grid ColumnDefinitions="*,*" FlowDirection="LeftToRight">
                            <Label Text="{Binding PositionText}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" HorizontalTextAlignment="Start" />
                            <Label Grid.Column="1" Text="{Binding DurationText}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" HorizontalTextAlignment="End" />
                        </Grid>
                        <HorizontalStackLayout Spacing="28" HorizontalOptions="Center" FlowDirection="LeftToRight">
                            <ImageButton Source="icon_skip_previous.png" Style="{StaticResource AudioSmallIconButton}"
                                         Command="{Binding SeekBackwardCommand}" IsEnabled="{Binding IsReady}" />
                            <ImageButton Source="{Binding PlayIcon}" Style="{StaticResource AudioPlayIconButton}"
                                         Command="{Binding PlayCommand}" IsEnabled="{Binding IsReady}" />
                            <ImageButton Source="icon_skip_next.png" Style="{StaticResource AudioSmallIconButton}"
                                         Command="{Binding SeekForwardCommand}" IsEnabled="{Binding IsReady}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" HorizontalTextAlignment="Center" />
                        <Label Text="موقعیت پخش خودکار ذخیره می‌شود."
                               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button IsVisible="{Binding IsPdfBook}" Text="{Binding ReadButtonText}" Style="{StaticResource PrimaryActionButton}" Command="{Binding ReadCommand}" />
                <Border IsVisible="{Binding IsDownloadPanelVisible}" BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkPrimarySoft}}" StrokeThickness="0" Padding="13,10" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DownloadStatus}" FontSize="14" TextColor="{StaticResource PrimaryDark}" />
                            <Label Grid.Column="1" Text="{Binding DownloadPercentText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                        </Grid>
                        <ProgressBar Progress="{Binding DownloadProgress}" ProgressColor="{StaticResource Tertiary}" BackgroundColor="{StaticResource ProgressTrack}" />
                    </VerticalStackLayout>
                </Border>
                <Grid IsVisible="{Binding IsPdfBook}" ColumnDefinitions="*,*,*" ColumnSpacing="9" FlowDirection="LeftToRight">
                    <Button Text="اشتراک" ImageSource="icon_share.png" Style="{StaticResource SecondaryActionButton}" Command="{Binding ShareCommand}" />
                    <Button Grid.Column="1" Text="{Binding DownloadButtonText}" ImageSource="icon_download.png" Style="{StaticResource SecondaryActionButton}" Command="{Binding DownloadCommand}" />
                    <Button Grid.Column="2" Text="{Binding FavoriteText}" ImageSource="{Binding FavoriteIcon}" Style="{StaticResource SecondaryActionButton}" Command="{Binding FavoriteCommand}" />
                </Grid>
                <Grid IsVisible="{Binding IsAudioBook}" ColumnDefinitions="*,*" ColumnSpacing="9" FlowDirection="LeftToRight">
                    <Button Text="اشتراک" ImageSource="icon_share.png" Style="{StaticResource SecondaryActionButton}" Command="{Binding ShareCommand}" />
                    <Button Grid.Column="1" Text="{Binding FavoriteText}" ImageSource="{Binding FavoriteIcon}" Style="{StaticResource SecondaryActionButton}" Command="{Binding FavoriteCommand}" />
                </Grid>
                <Border Style="{StaticResource BookDetailCard}" Padding="14">
                    <Grid ColumnDefinitions="*,*,*" FlowDirection="LeftToRight">
                        <VerticalStackLayout HorizontalOptions="Center"><Label Text="امتیاز" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Score}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center"><Label Text="حجم" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Size}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center"><Label Text="{Binding PagesLabel}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Pages}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BookDetailCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="{Binding LikeText}" Style="{StaticResource SecondaryActionButton}" Command="{Binding LikeCommand}" />
                            <Label Grid.Column="1" Text="{Binding RatingText}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light={StaticResource BodyMuted}, Dark={StaticResource DarkMutedText}}" />
                        </Grid>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="7" FlowDirection="LeftToRight">
                            <Button Text="★ 1" Command="{Binding RateCommand}" CommandParameter="1" Style="{StaticResource SecondaryActionButton}" />
                            <Button Text="★ 2" Command="{Binding RateCommand}" CommandParameter="2" Style="{StaticResource SecondaryActionButton}" />
                            <Button Text="★ 3" Command="{Binding RateCommand}" CommandParameter="3" Style="{StaticResource SecondaryActionButton}" />
                            <Button Text="★ 4" Command="{Binding RateCommand}" CommandParameter="4" Style="{StaticResource SecondaryActionButton}" />
                            <Button Text="★ 5" Command="{Binding RateCommand}" CommandParameter="5" Style="{StaticResource SecondaryActionButton}" />
                        </HorizontalStackLayout>
                        <Button Text="حذف امتیاز من" Command="{Binding RateCommand}" CommandParameter="remove" Style="{StaticResource SecondaryActionButton}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource BookDetailCard}"><VerticalStackLayout Spacing="10">
                    <Label HorizontalTextAlignment="Start" Text="درباره کتاب" Style="{StaticResource SectionHeading}" />
                    <Label Text="{Binding Description}" FontSize="17" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource BodyText}, Dark={StaticResource DarkBodyText}}" HorizontalTextAlignment="Start" />
                </VerticalStackLayout></Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
