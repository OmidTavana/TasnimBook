<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels" x:Class="TasnimBook.MAUI.Views.BookDetailPage"
             x:DataType="viewModels:BookDetailViewModel" FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource PageWarmBackground}" Title="جزئیات کتاب">
    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource BookDetailHeader}" ColumnDefinitions="52,*,52" FlowDirection="LeftToRight">
            <ImageButton Source="icon_back.svg" Style="{StaticResource HeaderIconButton}" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="جزئیات کتاب" FontSize="25" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <ImageButton Grid.Column="2" Source="{Binding FavoriteIcon}" Style="{StaticResource HeaderIconButton}" Command="{Binding FavoriteCommand}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,34" Spacing="16">
                <Border Style="{StaticResource BookDetailCard}">
                    <Grid ColumnDefinitions="*,142" ColumnSpacing="18" FlowDirection="RightToLeft">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" LineBreakMode="WordWrap" HorizontalTextAlignment="Start" TextColor="#24211E" />
                            <Label Text="{Binding Author}" FontSize="17" TextColor="{StaticResource BodyMuted}" HorizontalTextAlignment="Start" />
                            <Border BackgroundColor="#FFF4D9" StrokeThickness="0" Padding="10,6" HorizontalOptions="Start" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding ProgressText}" FontSize="13" TextColor="#765A12" />
                            </Border>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="142" HeightRequest="205" BackgroundColor="#2C5AA0" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Image Source="{Binding CoverImage}" Aspect="AspectFill" />
                        </Border>
                    </Grid>
                </Border>
                <Button Text="{Binding ReadButtonText}" Style="{StaticResource PrimaryActionButton}" Command="{Binding ReadCommand}" />
                <Border IsVisible="{Binding IsDownloadPanelVisible}" BackgroundColor="#FFF4D9" StrokeThickness="0" Padding="13,10" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DownloadStatus}" FontSize="14" TextColor="#5B430B" />
                            <Label Grid.Column="1" Text="{Binding DownloadPercentText}" FontAttributes="Bold" TextColor="#5B430B" />
                        </Grid>
                        <ProgressBar Progress="{Binding DownloadProgress}" ProgressColor="{StaticResource PrimaryDark}" BackgroundColor="#EADDBB" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9" FlowDirection="LeftToRight">
                    <Button Text="اشتراک" ImageSource="icon_share.svg" Style="{StaticResource SecondaryActionButton}" Command="{Binding ShareCommand}" />
                    <Button Grid.Column="1" Text="{Binding DownloadButtonText}" ImageSource="icon_download.svg" Style="{StaticResource SecondaryActionButton}" Command="{Binding DownloadCommand}" />
                    <Button Grid.Column="2" Text="{Binding FavoriteText}" ImageSource="{Binding FavoriteIcon}" Style="{StaticResource SecondaryActionButton}" Command="{Binding FavoriteCommand}" />
                </Grid>
                <Border Style="{StaticResource BookDetailCard}" Padding="14">
                    <Grid ColumnDefinitions="*,*,*" FlowDirection="LeftToRight">
                        <VerticalStackLayout HorizontalOptions="Center"><Label Text="امتیاز" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Score}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center"><Label Text="حجم" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Size}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center"><Label Text="تعداد صفحات" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Pages}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BookDetailCard}"><VerticalStackLayout Spacing="10">
                    <Label HorizontalTextAlignment="Start" Text="درباره کتاب" Style="{StaticResource SectionHeading}" />
                    <Label Text="{Binding Description}" FontSize="17" LineHeight="1.55" TextColor="#3E3A36" HorizontalTextAlignment="Start" />
                </VerticalStackLayout></Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
