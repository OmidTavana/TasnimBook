<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels"
             xmlns:controls="clr-namespace:TasnimBook.MAUI.Controls"
             x:Class="TasnimBook.MAUI.Views.BookReaderPage"
             x:DataType="viewModels:BookReaderViewModel" BackgroundColor="{StaticResource ReaderBackground}" FlowDirection="RightToLeft">
    <Grid RowDefinitions="Auto,3,*">
        <Grid Style="{StaticResource BookDetailHeader}" ColumnDefinitions="52,*,52" FlowDirection="LeftToRight">
            <ImageButton Source="icon_back.png" Style="{StaticResource HeaderIconButton}" Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource White}" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                <Label Text="{Binding PageText}" FontSize="12" TextColor="{StaticResource ReaderSubtext}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
        <ProgressBar Grid.Row="1" Progress="{Binding PageProgress}" ProgressColor="{StaticResource PrimaryDark}" />
        <Grid Grid.Row="2" IsClippedToBounds="True" FlowDirection="LeftToRight">
            <controls:PlatformPdfReader x:Name="PdfReader"
                                        SourcePath="{Binding LocalPath}"
                                        CurrentPage="{Binding CurrentPageIndex, Mode=TwoWay}"
                                        Zoom="{Binding Zoom, Mode=TwoWay}"
                                        DocumentLoaded="OnDocumentLoaded"
                                        PageChanged="OnPageChanged"
                                        Error="OnReaderError" />
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               InputTransparent="True"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
            <Label Text="{Binding ReaderError}"
                   IsVisible="{Binding HasReaderError}"
                   Margin="16"
                   Padding="12,8"
                   BackgroundColor="{StaticResource AppBackground}"
                   TextColor="{StaticResource Error}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="End"
                   InputTransparent="True" />
        </Grid>
    </Grid>
</ContentPage>
