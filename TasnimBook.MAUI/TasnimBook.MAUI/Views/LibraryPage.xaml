<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TasnimBook.MAUI.ViewModels" x:Class="TasnimBook.MAUI.Views.LibraryPage"
             xmlns:models="clr-namespace:TasnimBook.Data.Models;assembly=TasnimBook.Data"
             x:Name="Root" x:DataType="viewModels:LibraryViewModel" Title="کتابخانه من" FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageWarmBackground}, Dark={StaticResource DarkAppBackground}}">
    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Books}" EmptyView="با شروع مطالعه یا دانلود، کتاب‌ها اینجا اضافه می‌شوند.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BooksDTO">
                    <Border Style="{StaticResource BookDetailCard}" Padding="10" Margin="12,6">
                        <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12" FlowDirection="LeftToRight">
                            <Image Source="{Binding ImageUrl}" WidthRequest="70" HeightRequest="98" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                                <Label Text="{Binding AuthorName}" Style="{StaticResource MutedLabel}" />
                                <Button Text="مطالعه" Clicked="OnOpenClicked" CommandParameter="{Binding .}" Style="{StaticResource SecondaryActionButton}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="حذف" Clicked="OnRemoveClicked" CommandParameter="{Binding .}" Style="{StaticResource SecondaryActionButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
