@model DashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد";

    var contentStats = new[]
    {
        new { label = "کتاب‌ها", value = Model.TotalBooks },
        new { label = "نویسندگان", value = Model.TotalAuthors },
        new { label = "دسته‌بندی‌ها", value = Model.TotalCategories }
    };

    var engagementStats = new[]
    {
        new { label = "دانلودها", value = Model.TotalDownloads },
        new { label = "پسندها", value = Model.TotalLikes },
        new { label = "امتیازها", value = Model.TotalRatings }
    };

    var popularBooks = Model.PopularBooks
        .Take(6)
        .Select(book => new { title = book.Title, value = book.PopularityScore });

    var statCards = new[]
    {
        new { Label = "کل کتاب‌ها", Value = Model.TotalBooks, Kind = "violet", Icon = "book" },
        new { Label = "کاربران ثبت‌شده", Value = Model.TotalRegisteredUsers, Kind = "cyan", Icon = "users" },
        new { Label = "مجموع دانلود", Value = Model.TotalDownloads, Kind = "green", Icon = "download" },
        new { Label = "درخواست مدیر", Value = Model.PendingAdministratorRegistrations, Kind = "amber", Icon = "shield" }
    };
}

<div class="page-header">
    <div class="page-title">
        <span class="eyebrow">امروز چه خبر است؟</span>
        <h1>نمای کلی تسنیم‌بوک</h1>
        <p>عملکرد محتوا و تعامل کاربران را در یک نگاه دنبال کنید.</p>
    </div>

    <div class="page-actions">
        <a class="button" asp-controller="Content" asp-action="CreateBook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z" /></svg>
            افزودن کتاب
        </a>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="toast toast-error">
        <span class="toast-dot"></span>
        <span>@error</span>
    </div>
}

<section class="stats-grid" aria-label="آمار کلیدی">
    @foreach (var statistic in statCards)
    {
        <article class="card stat-card stat-@statistic.Kind">
            <div class="stat-top">
                <span class="stat-label">@statistic.Label</span>
                <span class="stat-icon">
                    @switch (statistic.Icon)
                    {
                        case "book":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 3h12A2.5 2.5 0 0 1 19 5.5V18h-1.5a3.5 3.5 0 0 0-3.5 3.5V22H4.5A2.5 2.5 0 0 1 2 19.5v-14A2.5 2.5 0 0 1 4.5 3Zm12 16c.17 0 .34.01.5.04V5.5a.5.5 0 0 0-.5-.5h-12a.5.5 0 0 0-.5.5v14a.5.5 0 0 0 .5.5h8.03a5.48 5.48 0 0 1 3.97-1Z" /></svg>
                            break;
                        case "users":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM8 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 0c-2.67 0-8 1.34-8 4v3h14v-3c0-2.66-3.33-4-6-4ZM8 15c-3.11 0-6 1.57-6 4v1h4v-3c0-.73.26-1.39.7-1.98A8.7 8.7 0 0 0 8 15Z" /></svg>
                            break;
                        case "download":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3ZM4 19h16v2H4v-2Z" /></svg>
                            break;
                        default:
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.05 3.41 9.76 8 11 4.59-1.24 8-5.95 8-11V5l-8-3Zm0 2.13L18 6.4V11c0 3.84-2.43 7.64-6 8.92C8.43 18.64 6 14.84 6 11V6.4l6-2.27Z" /></svg>
                            break;
                    }
                </span>
            </div>
            <strong class="stat-value">@statistic.Value.ToString("N0")</strong>
        </article>
    }
</section>

<div class="charts-grid"
     data-dashboard
     data-content-stats="@JsonSerializer.Serialize(contentStats)"
     data-engagement-stats="@JsonSerializer.Serialize(engagementStats)"
     data-popular-books="@JsonSerializer.Serialize(popularBooks)">
    <section class="card chart-card">
        <header class="card-header">
            <div>
                <h2>تعامل کاربران</h2>
                <p>مقایسه دانلود، پسند و امتیاز ثبت‌شده</p>
            </div>
            <span class="badge badge-primary">زنده</span>
        </header>
        <div class="chart-container">
            <canvas id="engagement-chart"></canvas>
        </div>
    </section>

    <section class="card chart-card">
        <header class="card-header">
            <div>
                <h2>ترکیب محتوا</h2>
                <p>پراکندگی منابع کتابخانه</p>
            </div>
        </header>
        <div class="chart-container chart-small">
            <canvas id="content-chart"></canvas>
        </div>
    </section>
</div>

<section class="card chart-card mb-1">
    <header class="card-header">
        <div>
            <h2>محبوب‌ترین کتاب‌ها</h2>
            <p>بر پایه دانلود، پسند و تعداد امتیاز</p>
        </div>
    </header>
    <div class="chart-container">
        @if (Model.PopularBooks.Count == 0)
        {
            <div class="empty-state">
                <div>
                    <h2>هنوز داده‌ای ثبت نشده</h2>
                    <p>با شروع تعامل کاربران، نمودار محبوبیت در این بخش نمایش داده می‌شود.</p>
                </div>
            </div>
        }
        else
        {
            <canvas id="popular-books-chart"></canvas>
        }
    </div>
</section>

<div class="dashboard-lists">
    <section class="card">
        <header class="card-header">
            <div>
                <h2>بیشترین دانلود</h2>
                <p>کتاب‌هایی که بیشتر دریافت شده‌اند</p>
            </div>
        </header>
        <partial name="_RankedBooks" model="Model.MostDownloadedBooks" />
    </section>

    <section class="card">
        <header class="card-header">
            <div>
                <h2>بالاترین امتیاز</h2>
                <p>با حداقل سه رأی معتبر</p>
            </div>
        </header>
        <partial name="_RankedBooks" model="Model.HighestRatedBooks" />
    </section>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
