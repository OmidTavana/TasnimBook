@model DashboardDto
@{
    ViewData["Title"] = "داشبورد";

    var statistics = new[]
    {
        (Title: "کتاب‌ها", Value: Model.TotalBooks),
        (Title: "نویسندگان", Value: Model.TotalAuthors),
        (Title: "دسته‌ها", Value: Model.TotalCategories),
        (Title: "کاربران", Value: Model.TotalRegisteredUsers),
        (Title: "دانلودها", Value: Model.TotalDownloads),
        (Title: "پسندها", Value: Model.TotalLikes),
        (Title: "امتیازها", Value: Model.TotalRatings),
        (Title: "درخواست مدیر", Value: Model.PendingAdministratorRegistrations)
    };
}

<h1>داشبورد</h1>

@if (ViewBag.Error is string error)
{
    <div class="notice error">@error</div>
}

<div class="grid">
    @foreach (var statistic in statistics)
    {
        <article class="card stat">
            <span>@statistic.Title</span>
            <strong>@statistic.Value</strong>
        </article>
    }
</div>

<div class="grid" style="margin-top: 20px">
    <section class="card">
        <h2>محبوب‌ترین کتاب‌ها</h2>
        <partial name="_RankedBooks" model="Model.PopularBooks" />
    </section>

    <section class="card">
        <h2>بیشترین دانلود</h2>
        <partial name="_RankedBooks" model="Model.MostDownloadedBooks" />
    </section>

    <section class="card">
        <h2>بیشترین پسند</h2>
        <partial name="_RankedBooks" model="Model.MostLikedBooks" />
    </section>

    <section class="card">
        <h2>بالاترین امتیاز</h2>
        <p class="muted">حداقل ۳ رأی</p>
        <partial name="_RankedBooks" model="Model.HighestRatedBooks" />
    </section>
</div>
