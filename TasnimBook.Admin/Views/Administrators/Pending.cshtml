@model IReadOnlyList<AdminUserDto>
@{
    ViewData["Title"] = "درخواست‌های مدیر";
}

<div class="page-header">
    <div class="page-title">
        <span class="eyebrow">کنترل دسترسی</span>
        <h1>درخواست‌های مدیریت</h1>
        <p>سطح دسترسی متقاضیان را پس از بررسی هویت و نیاز کاری تعیین کنید.</p>
    </div>
    <div class="page-actions">
        <a class="button button-secondary" asp-action="Index">مشاهده همه مدیران</a>
    </div>
</div>

<section class="card table-card">
    <div class="table-toolbar">
        <span class="badge badge-warning">@Model.Count.ToString("N0") درخواست در انتظار</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div>
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 16.2-3.5-3.5L4.1 14.1 9 19 20.3 7.7l-1.4-1.4L9 16.2Z" /></svg>
                </div>
                <h2>همه درخواست‌ها بررسی شده‌اند</h2>
                <p>در حال حاضر درخواست مدیریتی در انتظار تصمیم شما نیست.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>متقاضی</th>
                        <th>تاریخ درخواست</th>
                        <th>تصمیم و سطح دسترسی</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var administrator in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-identity">
                                    <span class="table-avatar">@administrator.DisplayName.Trim().FirstOrDefault()</span>
                                    <div class="identity-copy">
                                        <strong>@administrator.DisplayName</strong>
                                        <small dir="ltr">@administrator.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>@administrator.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>
                                <form class="review-form" asp-action="Review" method="post">
                                    <input type="hidden" name="id" value="@administrator.Id" />

                                    <select name="role" aria-label="نقش مدیریتی">
                                        <option value="ContentAdmin">مدیر محتوا</option>
                                        <option value="SuperAdmin">مدیر ارشد</option>
                                    </select>

                                    <input name="note" placeholder="یادداشت بررسی (اختیاری)" aria-label="یادداشت بررسی" />

                                    <div class="review-actions">
                                        <button class="button button-sm" name="approve" value="true" type="submit">تأیید</button>
                                        <button class="button button-danger button-sm" name="approve" value="false" type="submit">رد</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
