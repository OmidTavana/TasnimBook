@model LoginAccountRequest
@{
    ViewData["Title"] = "ورود مدیر";
}

<section class="auth-layout">
    <partial name="_AuthVisual" />

    <div class="auth-panel">
        <header class="auth-panel-header">
            <span class="eyebrow">خوش آمدید</span>
            <h1>ورود به پنل مدیریت</h1>
            <p>برای ادامه، اطلاعات حساب مدیریتی خود را وارد کنید.</p>
        </header>

        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label asp-for="Email">نشانی ایمیل</label>
                <input asp-for="Email" type="email" dir="ltr" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="field mt-1">
                <label asp-for="Password">رمز عبور</label>
                <div class="password-field">
                    <input asp-for="Password" type="password" id="login-password" dir="ltr" placeholder="••••••••••••" autocomplete="current-password" />
                    <button class="password-toggle" type="button" data-password-toggle="#login-password" aria-label="نمایش رمز عبور" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c-5.5 0-9.5 5.2-10 6.5.5 1.3 4.5 6.5 10 6.5s9.5-5.2 10-6.5C21.5 10.2 17.5 5 12 5Zm0 11a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <button class="button w-full mt-lg" type="submit">ورود به داشبورد</button>
        </form>

        <p class="auth-footer">
            هنوز حساب مدیریتی ندارید؟
            <a asp-action="Register">ثبت درخواست دسترسی</a>
        </p>
    </div>
</section>
