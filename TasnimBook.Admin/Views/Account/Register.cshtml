@model AdminRegisterRequest
@{
    ViewData["Title"] = "درخواست دسترسی";
}

<section class="auth-layout">
    <partial name="_AuthVisual" />

    <div class="auth-panel">
        <header class="auth-panel-header">
            <span class="eyebrow">عضویت تیم محتوا</span>
            <h1>درخواست حساب مدیریتی</h1>
            <p>درخواست شما پس از بررسی SuperAdmin فعال خواهد شد.</p>
        </header>

        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label asp-for="DisplayName">نام نمایشی</label>
                <input asp-for="DisplayName" placeholder="نام و نام خانوادگی" autocomplete="name" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="field mt-1">
                <label asp-for="Email">نشانی ایمیل</label>
                <input asp-for="Email" type="email" dir="ltr" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="field mt-1">
                <label asp-for="Password">رمز عبور</label>
                <div class="password-field">
                    <input asp-for="Password" type="password" id="register-password" dir="ltr" placeholder="حداقل ۱۰ کاراکتر" autocomplete="new-password" />
                    <button class="password-toggle" type="button" data-password-toggle="#register-password" aria-label="نمایش رمز عبور" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c-5.5 0-9.5 5.2-10 6.5.5 1.3 4.5 6.5 10 6.5s9.5-5.2 10-6.5C21.5 10.2 17.5 5 12 5Zm0 11a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z" /></svg>
                    </button>
                </div>
                <span class="field-hint">ترکیبی از حروف و اعداد استفاده کنید.</span>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="field mt-1">
                <label asp-for="ApplicationNote">توضیح درخواست</label>
                <textarea asp-for="ApplicationNote" rows="3" placeholder="نقش شما در تیم و دلیل نیاز به دسترسی..."></textarea>
            </div>

            <button class="button w-full mt-lg" type="submit">ارسال برای بررسی</button>
        </form>

        <p class="auth-footer">
            حساب مدیریتی دارید؟
            <a asp-action="Login">بازگشت به ورود</a>
        </p>
    </div>
</section>
