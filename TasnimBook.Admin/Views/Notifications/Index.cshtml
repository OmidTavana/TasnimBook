@model NotificationPageModel
@{
    ViewData["Title"] = "اعلان‌های اپلیکیشن";
}

<div class="page-header">
    <div class="page-title">
        <span class="eyebrow">ارتباط با کاربران</span>
        <h1>اعلان‌های اپلیکیشن</h1>
        <p>پیام عمومی یا اعلان نسخه تازه را برای نمایش در اجرای بعدی اپ ثبت کنید.</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly"></div>

<div class="form-layout">
    <div class="form-stack">
        <section class="card">
            <header class="card-header"><div><h2>اعلان جدید</h2><p>زمان‌ها بر اساس UTC ذخیره می‌شوند.</p></div></header>
            <form asp-action="Create" method="post" class="card-body form-grid">
                <div class="field field-full">
                    <label asp-for="Draft.Title">عنوان</label>
                    <input asp-for="Draft.Title" maxlength="120" placeholder="مثلاً هدیه امروز تسنیم‌بوک" />
                </div>
                <div class="field field-full">
                    <label asp-for="Draft.Message">متن پیام</label>
                    <textarea asp-for="Draft.Message" rows="5" maxlength="2000"></textarea>
                </div>
                <div class="field">
                    <label asp-for="Draft.NotificationType">نوع اعلان</label>
                    <select asp-for="Draft.NotificationType">
                        <option value="General">پیام مهم (Dialog)</option>
                        <option value="Information">اطلاع‌رسانی کوتاه</option>
                        <option value="Success">پیام موفقیت</option>
                        <option value="Warning">هشدار</option>
                        <option value="Error">خطا</option>
                        <option value="AppUpdate">نسخه جدید اپلیکیشن</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Draft.PlatformId">پلتفرم</label>
                    <select asp-for="Draft.PlatformId">
                        <option value="">همه پلتفرم‌ها</option>
                        <option value="1">Android</option>
                        <option value="2">Windows</option>
                        <option value="3">iOS</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Draft.PublishAtUtc">زمان انتشار UTC</label>
                    <input asp-for="Draft.PublishAtUtc" type="datetime-local" value="@Model.Draft.PublishAtUtc.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="field">
                    <label asp-for="Draft.ExpiresAtUtc">زمان پایان UTC (اختیاری)</label>
                    <input asp-for="Draft.ExpiresAtUtc" type="datetime-local" />
                </div>
                <div class="field">
                    <label asp-for="Draft.VersionName">نام نسخه</label>
                    <input asp-for="Draft.VersionName" placeholder="مثلاً 1.2.0" />
                </div>
                <div class="field">
                    <label asp-for="Draft.VersionNumber">شماره ساخت</label>
                    <input asp-for="Draft.VersionNumber" type="number" min="1" placeholder="مثلاً 12" />
                </div>
                <div class="field field-full">
                    <label asp-for="Draft.ActionUrl">آدرس مستقیم فایل نصب (اختیاری)</label>
                    <input asp-for="Draft.ActionUrl" type="url" dir="ltr" placeholder="APK برای Android یا MSIX/EXE برای Windows" />
                    <span class="field-hint">اگر خالی باشد، اطلاعات نسخه از جدول appversion خوانده می‌شود.</span>
                </div>
                <div class="switch-row field-full">
                    <div class="switch-copy"><strong>فعال باشد</strong><small>فقط اعلان فعال به کاربران نمایش داده می‌شود.</small></div>
                    <label class="switch"><input asp-for="Draft.IsActive" /><span></span></label>
                </div>
                <div class="form-actions field-full">
                    <button class="button" type="submit">ثبت اعلان</button>
                </div>
            </form>
        </section>
    </div>

    <div class="form-stack">
        <section class="card table-card">
            <div class="table-toolbar"><span class="badge badge-primary">@Model.Items.Count اعلان</span></div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>عنوان</th><th>نوع</th><th>انتشار</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><strong>@item.Title</strong><br /><small>@item.Message</small></td>
                            <td><span class="badge badge-primary">@item.NotificationType</span></td>
                            <td>@item.PublishAtUtc.ToString("yyyy/MM/dd HH:mm") UTC</td>
                            <td><span class="badge @(item.IsActive ? "badge-success" : "badge-warning")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                            <td>
                                <form asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="button button-ghost" type="submit">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
