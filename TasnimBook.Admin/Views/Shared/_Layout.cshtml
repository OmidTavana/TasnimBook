@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var displayName = User.Identity?.Name ?? "مدیر";
    var userInitial = displayName.Trim().FirstOrDefault().ToString();

    string NavClass(string controller, string? action = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionMatches = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return controllerMatches && actionMatches ? "nav-link is-active" : "nav-link";
    }
}

<!doctype html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b12" />
    <title>@ViewData["Title"] | مدیریت تسنیم‌بوک</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/js/admin-shell.js" asp-append-version="true" defer></script>
</head>
<body class="@(isAuthenticated ? "app-body" : "auth-body")">
    @if (isAuthenticated)
    {
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="sidebar" id="admin-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="تسنیم‌بوک">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" role="img">
                        <path d="M8 6.5c3.5 0 6.2 1.1 8 3.3 1.8-2.2 4.5-3.3 8-3.3v18.2c-3.5 0-6.2 1.1-8 3.3-1.8-2.2-4.5-3.3-8-3.3V6.5Z" />
                        <path d="M16 10v17" />
                    </svg>
                </span>
                <span>
                    <strong>تسنیم‌بوک</strong>
                    <small>مرکز مدیریت محتوا</small>
                </span>
            </a>

            <nav class="sidebar-nav" aria-label="منوی اصلی">
                <span class="nav-caption">نمای کلی</span>

                <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z" /></svg>
                    <span>داشبورد</span>
                </a>

                <span class="nav-caption">مدیریت محتوا</span>

                <a class="@NavClass("Content", "Books")" asp-controller="Content" asp-action="Books">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 3h12A2.5 2.5 0 0 1 19 5.5V18h-1.5a3.5 3.5 0 0 0-3.5 3.5V22H4.5A2.5 2.5 0 0 1 2 19.5v-14A2.5 2.5 0 0 1 4.5 3Zm12 16c.17 0 .34.01.5.04V5.5a.5.5 0 0 0-.5-.5h-12a.5.5 0 0 0-.5.5v14a.5.5 0 0 0 .5.5h8.03a5.48 5.48 0 0 1 3.97-1Z" /></svg>
                    <span>کتاب‌ها</span>
                </a>

                <a class="@NavClass("Content", "Authors")" asp-controller="Content" asp-action="Authors">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14Z" /></svg>
                    <span>نویسندگان</span>
                </a>

                <a class="@NavClass("Content", "Categories")" asp-controller="Content" asp-action="Categories">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.1-8.5-8.5A2 2 0 0 0 11.5 2H4a2 2 0 0 0-2 2v7.5a2 2 0 0 0 .6 1.4l8.5 8.5a2 2 0 0 0 2.8 0l7.5-7.5a2 2 0 0 0 0-2.8ZM7 9.5A2.5 2.5 0 1 1 7 4.5a2.5 2.5 0 0 1 0 5Z" /></svg>
                    <span>دسته‌بندی‌ها</span>
                </a>

                @if (User.IsInRole(UserRoles.SuperAdmin))
                {
                    <span class="nav-caption">دسترسی‌ها</span>

                    <a class="@NavClass("Notifications")" asp-controller="Notifications" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6v-5a7 7 0 0 0-5-6.71V3a2 2 0 1 0-4 0v1.29A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z" /></svg>
                        <span>اعلان‌های اپ</span>
                    </a>

                    <a class="@NavClass("Administrators", "Pending")" asp-controller="Administrators" asp-action="Pending">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM8 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 0c-2.67 0-8 1.34-8 4v3h14v-3c0-2.66-3.33-4-6-4ZM8 15c-3.11 0-6 1.57-6 4v1h4v-3c0-.73.26-1.39.7-1.98A8.7 8.7 0 0 0 8 15Z" /></svg>
                        <span>درخواست‌های مدیر</span>
                    </a>

                    <a class="@NavClass("Administrators", "Index")" asp-controller="Administrators" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm7.4 12.5L22 17.1l-1.4 1.4-1.2-1.2V22h-2v-4.7l-1.2 1.2-1.4-1.4 2.6-2.6a1.4 1.4 0 0 1 2 0ZM3 21.5V20c0-3.3 4-6 9-6 .7 0 1.4.05 2.05.15A5.5 5.5 0 0 0 15 23H4.5A1.5 1.5 0 0 1 3 21.5Z" /></svg>
                        <span>مدیران</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-card">
                    <span class="avatar">@userInitial</span>
                    <span class="user-meta">
                        <strong>@displayName</strong>
                        <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="icon-button" type="submit" aria-label="خروج از حساب" title="خروج">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17v-2h7V9h-7V7l-5 5 5 5Zm9-14H5a2 2 0 0 0-2 2v4h2V5h14v14H5v-4H3v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Z" /></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="app-shell">
            <header class="topbar">
                <div class="topbar-heading">
                    <button class="icon-button sidebar-toggle" type="button" data-sidebar-toggle aria-label="باز کردن منو">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z" /></svg>
                    </button>
                    <div>
                        <span class="eyebrow">پنل مدیریت</span>
                        <strong>@ViewData["Title"]</strong>
                    </div>
                </div>

                <div class="topbar-actions">
                    <button class="icon-button" type="button" data-theme-toggle aria-label="تغییر پوسته" title="تغییر پوسته">
                        <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.3A8.5 8.5 0 0 1 8.7 3.5 9 9 0 1 0 20.5 15.3Z" /></svg>
                        <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-6 1 3h-2l1-3Zm0 20-1-3h2l-1 3ZM2 12l3-1v2l-3-1Zm20 0-3 1v-2l3 1ZM4.9 4.9l2.8 1.4-1.4 1.4-1.4-2.8Zm14.2 14.2-2.8-1.4 1.4-1.4 1.4 2.8ZM19.1 4.9l-1.4 2.8-1.4-1.4 2.8-1.4ZM4.9 19.1l1.4-2.8 1.4 1.4-2.8 1.4Z" /></svg>
                    </button>
                </div>
            </header>

            <main class="page-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="toast toast-success" data-dismissible>
                        <span class="toast-dot"></span>
                        <span>@success</span>
                        <button type="button" data-dismiss aria-label="بستن">×</button>
                    </div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="toast toast-error" data-dismissible>
                        <span class="toast-dot"></span>
                        <span>@error</span>
                        <button type="button" data-dismiss aria-label="بستن">×</button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="auth-shell">
            @RenderBody()
        </main>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
