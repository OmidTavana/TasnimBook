<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] - مدیریت تسنیم‌بوک</title><link rel="stylesheet" href="~/css/admin.css"/></head>
<body><header><a class="brand" asp-controller="Home" asp-action="Index">تسنیم‌بوک <small>مدیریت</small></a>@if(User.Identity?.IsAuthenticated == true){<nav><a asp-controller="Home" asp-action="Index">داشبورد</a><a asp-controller="Content" asp-action="Books">کتاب‌ها</a><a asp-controller="Content" asp-action="Authors">نویسندگان</a><a asp-controller="Content" asp-action="Categories">دسته‌ها</a>@if(User.IsInRole(UserRoles.SuperAdmin)){<a asp-controller="Administrators" asp-action="Pending">درخواست‌های مدیر</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="link">خروج</button></form></nav>}</header>
<main>@if(TempData["Success"] is string success){<div class="notice success">@success</div>}@if(TempData["Error"] is string error){<div class="notice error">@error</div>}@RenderBody()</main></body></html>
