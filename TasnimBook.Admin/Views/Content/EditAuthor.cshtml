@model Author
@{
    ViewData["Title"] = Model.Id == 0
        ? "نویسنده جدید"
        : "ویرایش نویسنده";
}

<section class="card auth">
    <h1>@ViewData["Title"]</h1>

    <form method="post">
        <input asp-for="Id" type="hidden" />

        <label asp-for="Name">نام</label>
        <input asp-for="Name" />

        <label asp-for="Family">نام خانوادگی</label>
        <input asp-for="Family" />

        <button>ذخیره</button>
    </form>
</section>
