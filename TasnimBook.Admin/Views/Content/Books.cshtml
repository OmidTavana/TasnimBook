@model PagedResult<Book>
@{ViewData["Title"]="کتاب‌ها";}<h1>مدیریت کتاب‌ها</h1><p><a class="button" asp-action="CreateBook">کتاب جدید</a></p><form class="toolbar"><input name="search" value="@ViewBag.Search" placeholder="جست‌وجوی عنوان"/><button>جست‌وجو</button></form><table><thead><tr><th>عنوان</th><th>نویسنده</th><th>فایل</th><th></th></tr></thead><tbody>@foreach(var b in Model.Items){<tr><td>@b.Title</td><td>@b.Author?.FullName</td><td>@b.Url</td><td><a class="button secondary" asp-action="EditBook" asp-route-id="@b.Id">ویرایش</a> <form asp-action="Delete" method="post" onsubmit="return confirm('کتاب حذف شود؟')"><input type="hidden" name="entity" value="Book"/><input type="hidden" name="id" value="@b.Id"/><button class="danger">حذف</button></form></td></tr>}</tbody></table><p>صفحه @Model.Page — @Model.TotalCount رکورد</p>
