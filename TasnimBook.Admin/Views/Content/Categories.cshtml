@model IReadOnlyList<BookCat>
@{ViewData["Title"]="دسته‌ها";}<h1>دسته‌ها</h1><p><a class="button" asp-action="EditCategory">دسته جدید</a></p><form class="toolbar"><input name="search" value="@ViewBag.Search" placeholder="جست‌وجو"/><button>جست‌وجو</button></form><table><thead><tr><th>نام</th><th>تعداد کتاب</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryName</td><td>@c.Books?.Count</td><td><a class="button secondary" asp-action="EditCategory" asp-route-id="@c.Id">ویرایش</a> <form asp-action="Delete" method="post"><input type="hidden" name="entity" value="Category"/><input type="hidden" name="id" value="@c.Id"/><button class="danger">حذف</button></form></td></tr>}</tbody></table>
