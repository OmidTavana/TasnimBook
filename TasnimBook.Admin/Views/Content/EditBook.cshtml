@model BookEditorModel
@{
    ViewData["Title"] = Model.Id == 0
        ? "کتاب جدید"
        : "ویرایش کتاب";
}

<section class="card">
    <h1>@ViewData["Title"]</h1>

    <form method="post" asp-action="EditBook">
        <div asp-validation-summary="All"></div>
        <input asp-for="Id" type="hidden" />

        <label asp-for="Title">عنوان</label>
        <input asp-for="Title" />

        <label asp-for="AuthorId">شناسه نویسنده</label>
        <input asp-for="AuthorId" type="number" />

        <label asp-for="CategoryIds">شناسه دسته‌ها (با ویرگول)</label>
        <input asp-for="CategoryIds" />

        <label asp-for="Description">توضیحات</label>
        <textarea asp-for="Description"></textarea>

        <label asp-for="Url">نشانی فایل کتاب</label>
        <input asp-for="Url" />

        <label asp-for="ImageUrl">نشانی تصویر جلد</label>
        <input asp-for="ImageUrl" />

        <label asp-for="FileSize">حجم</label>
        <input asp-for="FileSize" />

        <label asp-for="PagesCount">تعداد صفحات</label>
        <input asp-for="PagesCount" />

        <label>
            <input asp-for="IsSuggested" type="checkbox" />
            پیشنهادی
        </label>

        <label>
            <input asp-for="IsAudioBook" type="checkbox" />
            صوتی
        </label>

        <p>
            <button>ذخیره</button>
        </p>
    </form>
</section>
